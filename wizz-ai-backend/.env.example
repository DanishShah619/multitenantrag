# --- Postgres / Supabase ---
DATABASE_URL=postgresql+psycopg2://postgres:password@db.xxxx.supabase.co:5432/postgres
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Milvus / Zilliz Cloud (free tier: https://zilliz.com/cloud) ---
MILVUS_URI=https://in03-xxxx.api.gcp-us-west1.zillizcloud.com
MILVUS_TOKEN=your-zilliz-api-token
MILVUS_COLLECTION=wizz_chunks

# --- Embeddings: "local" = free, CPU, sentence-transformers ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_LOCAL=BAAI/bge-small-en-v1.5
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# --- Ingestion ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_UPLOAD_MB=20
INGESTION_MODE=sync
